
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "njs",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
